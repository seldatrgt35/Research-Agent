RESEARCH_AGENT_APP_NAME=Research Agent
RESEARCH_AGENT_ENVIRONMENT=local
RESEARCH_AGENT_DEBUG=false

RESEARCH_AGENT_API__TITLE=Research Agent API
RESEARCH_AGENT_API__VERSION=0.1.0
RESEARCH_AGENT_API__DOCS_URL=/docs
RESEARCH_AGENT_API__REDOC_URL=/redoc
RESEARCH_AGENT_API__OPENAPI_URL=/openapi.json

RESEARCH_AGENT_LOGGING__LEVEL=INFO
RESEARCH_AGENT_LOGGING__FORMAT=plain

RESEARCH_AGENT_DATABASE__URL=postgresql+asyncpg://research_agent:research_agent@localhost:5432/research_agent
RESEARCH_AGENT_DATABASE__ECHO=false
RESEARCH_AGENT_DATABASE__POOL_SIZE=5
RESEARCH_AGENT_DATABASE__MAX_OVERFLOW=10

APP_PORT=8000
POSTGRES_PORT=5432
POSTGRES_USER=research_agent
POSTGRES_PASSWORD=research_agent
POSTGRES_DB=research_agent

